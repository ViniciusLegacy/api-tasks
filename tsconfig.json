{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],

        "module": "node16",
        "paths": {
            "@/*": ["./src/*"],
        },
        "types": ["node", "jest"],

        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "strict": true,

        "skipLibCheck": true,
    },
}